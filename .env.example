# Copy to .env for local development. In Netlify, set these in the site's
# environment variables (Site settings -> Environment variables).

# Read-only GitHub token with access to the (private) wiki repo. In Netlify
# this is provided as a build environment variable. Optional for local dev if
# the export branch is public or you use a local fixture (see below).
GITHUB_TOKEN=

# The wiki repository and the branch that carries the export.
WIKI_REPO=Dark-Matter-Labs/indy-llm-wiki
WIKI_BRANCH=export
# Path within the repo to the PUBLIC export. The lens must only ever load the
# public file — never wiki.json (which contains private nodes).
WIKI_PUBLIC_PATH=export/wiki.public.json

# When true (or when the fetch fails and this is set), fall back to the local
# development fixture at public/data/wiki.sample.json instead of failing the
# build. Leave unset/false in production so a broken fetch fails loudly.
USE_SAMPLE_DATA=
